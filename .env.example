# Public URL of the deployed site (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery through Gmail's SMTP server. Leave empty in development to log
# messages to the server console instead.
# SMTP_USER: the Gmail address that sends the messages.
# SMTP_PASS: a Google App Password for that account (Google Account > Security >
#   2-Step Verification > App passwords; needs 2-Step Verification on). Not the normal password.
# CONTACT_TO_EMAIL: where messages are delivered. Defaults to SMTP_USER when empty.
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Optional: another SMTP server instead of Gmail (465 = TLS, 587 = STARTTLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
