# Public URL of the deployed site (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery via Resend (https://resend.com). Leave empty in development
# to log messages to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Dev Patel <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
